-- ASEM Global Platform - PostgreSQL schema v2
-- Supports unlimited language keys in JSONB, e.g.
-- {"en":"France","fr":"France","zh":"法国","ko":"프랑스","ar":"فرنسا"}
-- Requires PostgreSQL and the PostGIS extension package.

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS postgis;

CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$;

CREATE TABLE IF NOT EXISTS countries (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    code VARCHAR(10) NOT NULL,
    continent VARCHAR(100),
    currency_code VARCHAR(10),
    timezone VARCHAR(100),
    names JSONB NOT NULL,
    official_languages JSONB NOT NULL DEFAULT '[]'::jsonb,
    flag_url TEXT,
    description JSONB NOT NULL DEFAULT '{}'::jsonb,
    data_source VARCHAR(100),
    verified BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT countries_code_unique UNIQUE (code),
    CONSTRAINT countries_code_format CHECK (code ~ '^[A-Za-z0-9_-]{2,10}$'),
    CONSTRAINT countries_names_object CHECK (jsonb_typeof(names) = 'object'),
    CONSTRAINT countries_names_not_empty CHECK (names <> '{}'::jsonb),
    CONSTRAINT countries_official_languages_array CHECK (jsonb_typeof(official_languages) = 'array'),
    CONSTRAINT countries_description_object CHECK (jsonb_typeof(description) = 'object'),
    CONSTRAINT countries_currency_format CHECK (currency_code IS NULL OR currency_code ~ '^[A-Za-z]{3}$')
);

CREATE TABLE IF NOT EXISTS cities (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    country_id UUID NOT NULL,
    code VARCHAR(50),
    names JSONB NOT NULL,
    latitude NUMERIC(10,7),
    longitude NUMERIC(10,7),
    location GEOGRAPHY(Point,4326),
    timezone VARCHAR(100),
    population BIGINT,
    description JSONB NOT NULL DEFAULT '{}'::jsonb,
    data_source VARCHAR(100),
    verified BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT cities_country_fk FOREIGN KEY (country_id)
        REFERENCES countries(id) ON UPDATE CASCADE ON DELETE RESTRICT,
    CONSTRAINT cities_names_object CHECK (jsonb_typeof(names) = 'object'),
    CONSTRAINT cities_names_not_empty CHECK (names <> '{}'::jsonb),
    CONSTRAINT cities_coordinates_pair CHECK (
        (latitude IS NULL AND longitude IS NULL) OR
        (latitude IS NOT NULL AND longitude IS NOT NULL)
    ),
    CONSTRAINT cities_latitude_range CHECK (latitude IS NULL OR latitude BETWEEN -90 AND 90),
    CONSTRAINT cities_longitude_range CHECK (longitude IS NULL OR longitude BETWEEN -180 AND 180),
    CONSTRAINT cities_population_nonnegative CHECK (population IS NULL OR population >= 0),
    CONSTRAINT cities_description_object CHECK (jsonb_typeof(description) = 'object'),
    CONSTRAINT cities_country_code_unique UNIQUE (country_id, code)
);

CREATE TABLE IF NOT EXISTS businesses (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    city_id UUID NOT NULL,
    category VARCHAR(100),
    names JSONB NOT NULL,
    description JSONB NOT NULL DEFAULT '{}'::jsonb,
    address JSONB NOT NULL DEFAULT '{}'::jsonb,
    contact JSONB NOT NULL DEFAULT '{}'::jsonb,
    location GEOGRAPHY(Point,4326),
    website_url TEXT,
    verified BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT businesses_city_fk FOREIGN KEY (city_id)
        REFERENCES cities(id) ON UPDATE CASCADE ON DELETE RESTRICT,
    CONSTRAINT businesses_names_object CHECK (jsonb_typeof(names) = 'object'),
    CONSTRAINT businesses_names_not_empty CHECK (names <> '{}'::jsonb),
    CONSTRAINT businesses_description_object CHECK (jsonb_typeof(description) = 'object'),
    CONSTRAINT businesses_address_object CHECK (jsonb_typeof(address) = 'object'),
    CONSTRAINT businesses_contact_object CHECK (jsonb_typeof(contact) = 'object')
);

CREATE OR REPLACE FUNCTION sync_city_location()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
  IF NEW.latitude IS NOT NULL AND NEW.longitude IS NOT NULL THEN
    NEW.location = ST_SetSRID(ST_MakePoint(NEW.longitude, NEW.latitude), 4326)::geography;
  ELSE
    NEW.location = NULL;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS countries_set_updated_at ON countries;
CREATE TRIGGER countries_set_updated_at
BEFORE UPDATE ON countries
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

DROP TRIGGER IF EXISTS cities_set_updated_at ON cities;
CREATE TRIGGER cities_set_updated_at
BEFORE UPDATE ON cities
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

DROP TRIGGER IF EXISTS businesses_set_updated_at ON businesses;
CREATE TRIGGER businesses_set_updated_at
BEFORE UPDATE ON businesses
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

DROP TRIGGER IF EXISTS cities_sync_location ON cities;
CREATE TRIGGER cities_sync_location
BEFORE INSERT OR UPDATE OF latitude, longitude ON cities
FOR EACH ROW EXECUTE FUNCTION sync_city_location();

CREATE INDEX IF NOT EXISTS idx_countries_names_gin
    ON countries USING GIN (names jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_countries_description_gin
    ON countries USING GIN (description jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_countries_verified
    ON countries (verified);
CREATE INDEX IF NOT EXISTS idx_cities_country_id
    ON cities (country_id);
CREATE INDEX IF NOT EXISTS idx_cities_names_gin
    ON cities USING GIN (names jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_cities_description_gin
    ON cities USING GIN (description jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_cities_location_gist
    ON cities USING GIST (location);
CREATE INDEX IF NOT EXISTS idx_cities_verified
    ON cities (verified);
CREATE INDEX IF NOT EXISTS idx_businesses_city_id
    ON businesses (city_id);
CREATE INDEX IF NOT EXISTS idx_businesses_category
    ON businesses (category);
CREATE INDEX IF NOT EXISTS idx_businesses_names_gin
    ON businesses USING GIN (names jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_businesses_address_gin
    ON businesses USING GIN (address jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_businesses_contact_gin
    ON businesses USING GIN (contact jsonb_path_ops);
CREATE INDEX IF NOT EXISTS idx_businesses_location_gist
    ON businesses USING GIST (location);
CREATE INDEX IF NOT EXISTS idx_businesses_verified
    ON businesses (verified);

COMMENT ON COLUMN countries.names IS 'Unlimited language map: language tag -> localized name';
COMMENT ON COLUMN cities.names IS 'Unlimited language map: language tag -> localized name';
COMMENT ON COLUMN businesses.names IS 'Unlimited language map: language tag -> localized name';
COMMENT ON COLUMN cities.location IS 'WGS84 geographic point generated from longitude/latitude';
COMMENT ON COLUMN businesses.location IS 'WGS84 geographic point for map search';
