from app.extensions import db


class Country(db.Model):
    __tablename__ = "countries"

    id = db.Column(
        db.Integer,
        primary_key=True
    )

    name = db.Column(
        db.String(100),
        nullable=False,
        unique=True
    )

    code = db.Column(
        db.String(10),
        nullable=False,
        unique=True
    )

    cities = db.relationship(
        "City",
        back_populates="country",
        cascade="all, delete-orphan"
    )
