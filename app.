// Dark Mode
const themeToggle = document.getElementById("themeToggle");
themeToggle.onclick = () => {
    document.body.classList.toggle("dark");
};

// Language Detection
const userLang = navigator.language.startsWith("ar") ? "ar" : "en";
fetch(`lang/${userLang}.json`)
    .then(res => res.json())
    .then(data => {
        document.querySelectorAll("[data-i18n]").forEach(el => {
            el.textContent = data[el.getAttribute("data-i18n")];
        });
        document.documentElement.dir = userLang === "ar" ? "rtl" : "ltr";
    });

// Load Projects
fetch("projects.json")
    .then(res => res.json())
    .then(projects => {
        const container = document.getElementById("projectsContainer");
        projects.forEach(p => {
            container.innerHTML += `
                <div class="project-card">
                    <h3>${p.title}</h3>
                    <p>${p.description}</p>
                </div>
            `;
        });
    });
