    function renderGrid(
        grid,
        items,
        builder,
        emptyTitle,
        emptyMessage
    ) {

        if (!grid) {
            return;
        }

        if (!items.length) {

            setGridEmpty(
                grid,
                emptyTitle,
                emptyMessage
            );

            return;
        }

        grid.innerHTML =
            items
                .map(builder)
                .join("");

        finishGrid(grid);
    }
